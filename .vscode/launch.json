            "args": [
                "--round",
                "2",
                "--connect"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Webcam - live camera + detection (no robot)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main_mission.py",
            "args": [
                "--source",
                "webcam",
                "--connect"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Demo (no robot)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main_mission.py",
            "args": [
                "--source",
                "demo",
                "--connect"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Demo - old OpenCV window",
